// HOSTINGER MySQL DATABASE - User Data
// Migrated from Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model ApiCallTracker {
  date         String   @id
  call_count   Int      @default(0)
  last_call_at DateTime @default(now())

  @@index([date])
}

model CollectionItem {
  id                      String    @id @default(cuid())
  minifigure_no           String
  minifigure_name         String
  quantity                Int
  condition               String
  image_url               String?
  pricing_six_month_avg   Float?
  pricing_current_avg     Float?
  pricing_current_lowest  Float?
  pricing_suggested_price Float?
  pricing_currency_code   String?
  pricing_cached_at       DateTime?
  userId                  String
  date_added              DateTime  @default(now())
  last_updated            DateTime  @updatedAt
  User                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Listing                 Listing[]

  @@unique([userId, minifigure_no, condition])
  @@index([minifigure_no])
  @@index([userId])
  @@index([userId, condition])
}

model Listing {
  id               String         @id @default(cuid())
  userId           String
  collectionItemId String
  title            String
  description      String         @db.Text
  platform         String
  condition_detail String         @db.Text
  accessories      String?        @db.Text
  known_flaws      String?        @db.Text
  quantity_to_list Int            @default(1)
  list_price       Float?
  status           String         @default("draft")
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  sold_at          DateTime?
  CollectionItem   CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)
  User             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collectionItemId])
  @@index([status])
  @@index([userId])
  @@index([created_at])
}

model MinifigCache {
  minifigure_no    String   @id
  name             String
  category_id      Int
  image_url        String
  cached_at        DateTime @default(now())
  expires_at       DateTime
  keywords         Json?
  last_searched_at DateTime @default(now())

  @@index([expires_at])
  @@index([name])
}

model MinifigCatalog {
  minifigure_no String   @id
  name          String
  category_id   Int
  category_name String
  year_released String?
  weight_grams  Float?
  search_name   String

  // SEO description fields (all 4 languages)
  description_en           String?   @db.Text
  description_de           String?   @db.Text
  description_fr           String?   @db.Text
  description_es           String?   @db.Text
  description_generated_at DateTime?
  description_status       String?   @default("pending")

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([category_name])
  @@index([search_name])
  @@index([year_released])
  @@index([description_status])
}

model SetsCatalog {
  box_no        String   @id
  name          String
  category_id   Int
  category_name String
  year_released String?
  weight        String?
  search_name   String

  // SEO description fields (all 4 languages)
  description_en           String?   @db.Text
  description_de           String?   @db.Text
  description_fr           String?   @db.Text
  description_es           String?   @db.Text
  description_generated_at DateTime?
  description_status       String?   @default("pending")

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([category_name])
  @@index([search_name])
  @@index([year_released])
  @@index([description_status])
}

model PersonalCollectionItem {
  id                      String    @id @default(cuid())
  userId                  String
  minifigure_no           String
  minifigure_name         String
  quantity                Int       @default(1)
  condition               String    @default("new")
  image_url               String?
  pricing_six_month_avg   Float?
  pricing_current_avg     Float?
  pricing_current_lowest  Float?
  pricing_suggested_price Float?
  pricing_currency_code   String?
  pricing_cached_at       DateTime?
  notes                   String?
  acquisition_date        DateTime?
  acquisition_notes       String?
  display_location        String?
  date_added              DateTime  @default(now())
  last_updated            DateTime  @updatedAt
  User                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, minifigure_no, condition])
  @@index([userId])
  @@index([userId, condition])
}

model PriceCache {
  id              String   @id @default(cuid())
  item_no         String
  item_type       String   @default("MINIFIG")
  condition       String
  country_code    String   @default("US")
  region          String   @default("north_america")
  currency_code   String   @default("USD")
  six_month_avg   Float
  current_avg     Float
  current_lowest  Float
  suggested_price Float
  cached_at       DateTime @default(now())
  expires_at      DateTime
  price_source    String   @default("bricklink")
  confidence      Float    @default(1.0)

  @@unique([item_no, item_type, condition, country_code, region])
  @@index([expires_at])
  @@index([item_no, item_type])
}

model PriceHistory {
  id              String   @id @default(cuid())
  minifigure_no   String
  condition       String
  six_month_avg   Float
  current_avg     Float
  current_lowest  Float
  suggested_price Float
  recorded_at     DateTime @default(now())

  @@index([minifigure_no, condition])
  @@index([recorded_at])
}

model ScanHistory {
  id              String    @id @default(cuid())
  userId          String
  imageUrl        String?
  isMixed         Boolean   @default(false) // true if AI detected a custom/mixed figure
  detectedItemNo  String?   // complete-figure case only
  detectedName    String?   // complete-figure case only
  confidence      Float?    // complete-figure case only
  topMatches      Json?     // complete: alternate whole-figure guesses. mixed: {head, torso, legs, hair} part guesses
  scannedAt       DateTime  @default(now())
  wasCorrect      Boolean?  // complete-figure case only; null until feedback given
  correctedItemNo String?   // complete-figure case only
  partFeedback    Json?     // mixed-figure case only: {head: {wasCorrect, correctedItemNo}, torso: {...}, legs: {...}, hair: {...}}
  feedbackAt      DateTime?

  @@index([scannedAt])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SetInventoryItem {
  id                      String    @id @default(cuid())
  box_no                  String
  set_name                String
  category_name           String?
  quantity                Int
  condition               String
  image_url               String?
  pricing_six_month_avg   Float?
  pricing_current_avg     Float?
  pricing_current_lowest  Float?
  pricing_suggested_price Float?
  pricing_currency_code   String?
  pricing_cached_at       DateTime?
  userId                  String
  date_added              DateTime  @default(now())
  last_updated            DateTime  @updatedAt
  User                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, box_no, condition])
  @@index([box_no])
  @@index([userId])
  @@index([userId, condition])
  @@index([category_name])
}

model SetPersonalCollectionItem {
  id                      String    @id @default(cuid())
  userId                  String
  box_no                  String
  set_name                String
  category_name           String?
  quantity                Int       @default(1)
  condition               String    @default("new")
  image_url               String?
  pricing_six_month_avg   Float?
  pricing_current_avg     Float?
  pricing_current_lowest  Float?
  pricing_suggested_price Float?
  pricing_currency_code   String?
  pricing_cached_at       DateTime?
  notes                   String?
  acquisition_date        DateTime?
  acquisition_notes       String?
  display_location        String?
  date_added              DateTime  @default(now())
  last_updated            DateTime  @updatedAt
  User                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, box_no, condition])
  @@index([userId])
  @@index([userId, condition])
  @@index([category_name])
}

model User {
  id                         String                      @id @default(cuid())
  name                       String?
  email                      String                      @unique
  password                   String?
  emailVerified              DateTime?
  image                      String?
  preferredCurrency          String?                     @default("USD")
  preferredCountryCode       String?                     @default("US")
  preferredRegion            String?                     @default("north_america")
  currencySymbol             String?                     @default("$")
  locale                     String?                     @default("en-US")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  // Unused -- belonged to an abandoned AI-scanner-credits feature. Do NOT
  // reuse this for premium/subscription gating; see subscriptionStatus below.
  scanCredits                Int                         @default(0)
  stripeCustomerId           String?                     @unique
  stripeSubscriptionId       String?                     @unique
  subscriptionEndsAt         DateTime?
  subscriptionPlan           String?
  // Mirrors Stripe Subscription.status verbatim: active | trialing |
  // past_due | unpaid | canceled | incomplete | incomplete_expired | paused
  subscriptionStatus         String?
  // true = user canceled but retains access until subscriptionEndsAt
  subscriptionCancelAtPeriodEnd Boolean                  @default(false)
  showOnMinifigLeaderboard   Boolean?                    @default(true)
  showOnSetLeaderboard       Boolean?                    @default(true)
  leaderboardDisplayName     String?
  shareToken                 String?                     @unique
  shareEnabled               Boolean                     @default(false)
  shareTokenInventory        String?                     @unique
  shareEnabledInventory      Boolean                     @default(false)
  shareTokenInventoryPrivate String?                     @unique
  shareEnabledInventoryPrivate Boolean                   @default(false)
  shareTokenCollection       String?                     @unique
  shareEnabledCollection     Boolean                     @default(false)
  shareTokenCollectionPrivate String?                    @unique
  shareEnabledCollectionPrivate Boolean                  @default(false)
  shareTokenSetsInventory    String?                     @unique
  shareEnabledSetsInventory  Boolean                     @default(false)
  shareTokenSetsInventoryPrivate String?                 @unique
  shareEnabledSetsInventoryPrivate Boolean               @default(false)
  shareTokenSetsCollection   String?                     @unique
  shareEnabledSetsCollection Boolean                     @default(false)
  shareTokenSetsCollectionPrivate String?                @unique
  shareEnabledSetsCollectionPrivate Boolean              @default(false)
  totalPricingViews          Int                         @default(0)
  username                   String?                     @unique
  profilePublic              Boolean                     @default(true)
  Account                    Account[]
  CollectionItem             CollectionItem[]
  Listing                    Listing[]
  PersonalCollectionItem     PersonalCollectionItem[]
  SetInventoryItem           SetInventoryItem[]
  SetPersonalCollectionItem  SetPersonalCollectionItem[]
  Session                    Session[]
  WishlistItem               WishlistItem[]
  SetWishlistItem            SetWishlistItem[]
  PriceAlert                 PriceAlert[]

  @@index([username])
  @@index([profilePublic])
  @@index([subscriptionStatus])
}

model Sponsor {
  id          String        @id @default(cuid())
  name        String
  tier        SponsorTier
  logoUrl     String?
  websiteUrl  String
  tagline     String?       @db.Text
  description String?       @db.Text
  status      SponsorStatus @default(PENDING)
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int           @default(0)
  clickCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tier, status, sortOrder])
}

enum SponsorTier {
  GOLD
  SILVER
  BRONZE
}

enum SponsorStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
}

model SponsorClick {
  id        String   @id @default(cuid())
  sponsorId String
  timestamp DateTime @default(now())
  userAgent String?  @db.Text
  referer   String?  @db.Text
  ipAddress String?

  @@index([sponsorId, timestamp])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model AffiliateClick {
  id          String   @id @default(cuid())
  platform    String // "amazon" | "bricklink" | "rakuten"
  productType String // "set" | "minifig"
  productId   String // set number or minifig number
  productName String?
  clickedAt   DateTime @default(now())
  userId      String? // optional - if logged in

  @@index([platform])
  @@index([clickedAt])
  @@index([productId])
}

model WishlistItem {
  id              String   @id @default(cuid())
  userId          String
  minifigure_no   String
  minifigure_name String
  image_url       String?
  date_added      DateTime @default(now())
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, minifigure_no])
  @@index([userId])
  @@index([minifigure_no])
}

model SetWishlistItem {
  id         String   @id @default(cuid())
  userId     String
  box_no     String
  set_name   String
  image_url  String?
  date_added DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, box_no])
  @@index([userId])
  @@index([box_no])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  confirmed      Boolean   @default(false)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@index([email])
  @@index([confirmed])
}

model Donation {
  id                String   @id @default(cuid())
  paypalTxnId       String   @unique
  amount            Float
  currency          String   @default("USD")
  donorEmail        String
  donorName         String?
  displayName       String?
  showOnLeaderboard Boolean  @default(false)
  season            String
  status            String   @default("completed")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([season])
  @@index([showOnLeaderboard, season])
}

model AmazonDeal {
  id              String   @id @default(cuid())
  boxNo           String   @unique
  asin            String
  title           String   @db.Text
  currentPrice    Float
  listPrice       Float
  discountPercent Int
  isPrime         Boolean  @default(false)
  isAvailable     Boolean  @default(true)
  currency        String   @default("USD")
  productUrl      String   @db.Text
  imageUrl        String?  @db.Text
  lastUpdated     DateTime @default(now())

  @@index([discountPercent])
  @@index([lastUpdated])
  @@index([boxNo])
}

model Article {
  id               String   @id @default(cuid())
  slug             String   @unique
  status           String   @default("draft") // draft, published, archived
  featured         Boolean  @default(false)
  contentBlocks    String   @db.LongText // JSON stringified ArticleBlock[]
  readTimeMinutes  Int?
  category         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  publishedAt      DateTime?

  // Translations stored as JSON array
  translations     String   @db.Text // JSON stringified translation objects

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
  @@index([category])
}

model PriceFetchFailure {
  id            String   @id @default(cuid())
  item_no       String
  item_type     String   @default("MINIFIG") // MINIFIG or SET
  condition     String   // new or used
  country_code  String
  error_message String   @db.Text
  error_type    String   // NETWORK_ERROR, API_ERROR, NO_DATA, RATE_LIMIT
  attempt_count Int      @default(1)
  last_attempt  DateTime @default(now())
  first_failed  DateTime @default(now())
  resolved      Boolean  @default(false)
  resolved_at   DateTime?

  @@unique([item_no, item_type, condition, country_code])
  @@index([item_no])
  @@index([last_attempt])
  @@index([resolved])
  @@index([error_type])
}

model MonetizationEvent {
  id        String   @id @default(cuid())
  eventType String   // "pricing_view", "donation_cta_shown", "donation_cta_clicked", "donation_completed"
  userId    String?  // optional - can track anonymous events
  metadata  String?  @db.Text // JSON stringified metadata (amount, page, itemNo, etc)
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
  @@index([userId, eventType])
}

model PriceAlert {
  id            String   @id @default(cuid())
  userId        String
  item_no       String
  item_type     String   // "MINIFIG" | "SET"
  item_name     String
  condition     String   // "new" | "used"
  target_price  Float
  currency_code String   @default("USD")
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  triggered_at  DateTime?
  last_checked  DateTime?
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, item_no, item_type, condition])
  @@index([active, last_checked])
  @@index([userId])
  @@index([item_no, item_type])
}
