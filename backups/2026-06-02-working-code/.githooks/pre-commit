#!/bin/bash

# Pre-commit hook: Prevent Prisma schema changes on main branch
# This prevents production-breaking changes from being committed directly to main

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
SCHEMA_FILES="prisma/schema.prisma prisma/schema-hostinger.prisma prisma/schema-supabase.prisma"

# Check if we're on main or master branch
if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
  # Check if any schema files are being modified
  for schema_file in $SCHEMA_FILES; do
    if git diff --cached --name-only | grep -q "^$schema_file$"; then
      echo "❌ ERROR: Cannot commit Prisma schema changes directly to $CURRENT_BRANCH branch!"
      echo ""
      echo "📋 Database schema changes must be done on a feature branch to prevent breaking production."
      echo ""
      echo "To fix this:"
      echo "  1. Create a feature branch:"
      echo "     git checkout -b feature/your-feature-name"
      echo ""
      echo "  2. Commit your changes there:"
      echo "     git add $schema_file"
      echo "     git commit -m 'Add schema changes'"
      echo ""
      echo "  3. Test locally with migrations before merging to main"
      echo ""
      echo "Changed schema file: $schema_file"
      exit 1
    fi
  done
fi

# Allow commit if checks pass
exit 0
